{
  "datasets": [
    {
      "name": "ds_apps",
      "displayName": "Apps with flags",
      "queryLines": [
        "WITH snap AS (\n",
        "  SELECT * FROM apps_inventory_snapshot\n",
        "),\n",
        "creator_counts AS (\n",
        "  SELECT creator, count(*) AS creator_app_count\n",
        "  FROM snap\n",
        "  GROUP BY creator\n",
        "),\n",
        "obo AS (\n",
        "  SELECT\n",
        "    s.app_name,\n",
        "    max(o.activity_date) AS last_obo_date,\n",
        "    coalesce(sum(CASE WHEN o.activity_date >= date_sub(current_date(), :usage_days) THEN o.event_count END), 0) AS obo_events_window,\n",
        "    count(DISTINCT CASE WHEN o.activity_date >= date_sub(current_date(), :usage_days) THEN o.user_email END) AS obo_users_window\n",
        "  FROM snap s\n",
        "  INNER JOIN app_obo_activity_daily o\n",
        "    ON o.workspace_id = s.workspace_id\n",
        "    AND regexp_extract(o.acting_resource, '([^/]+)$', 1) IN (s.oauth2_app_client_id, s.app_id, s.app_name)\n",
        "  GROUP BY s.app_name\n",
        "),\n",
        "billed AS (\n",
        "  SELECT\n",
        "    u.usage_metadata.app_id AS app_id,\n",
        "    coalesce(sum(CASE WHEN u.usage_date >= date_sub(current_date(), :usage_days) THEN u.usage_quantity END), 0) AS dbus_window,\n",
        "    max(u.usage_date) AS last_billed_date\n",
        "  FROM system.billing.usage u\n",
        "  WHERE u.usage_date >= date_sub(current_date(), 90)\n",
        "    AND u.usage_metadata.app_id IS NOT NULL\n",
        "    AND u.workspace_id IN (SELECT DISTINCT workspace_id FROM snap)\n",
        "  GROUP BY u.usage_metadata.app_id\n",
        "),\n",
        "facts AS (\n",
        "  SELECT\n",
        "    s.app_name,\n",
        "    s.app_id,\n",
        "    s.creator,\n",
        "    s.creator_type,\n",
        "    s.creator_active,\n",
        "    c.creator_app_count,\n",
        "    s.app_state,\n",
        "    s.compute_state,\n",
        "    s.active_deployment_id,\n",
        "    coalesce(s.active_deployment_update_time, s.active_deployment_create_time) AS last_deploy_time,\n",
        "    s.create_time,\n",
        "    s.update_time,\n",
        "    greatest(\n",
        "      coalesce(s.active_deployment_update_time, s.active_deployment_create_time, s.create_time),\n",
        "      coalesce(s.update_time, s.create_time)\n",
        "    ) AS last_change_time,\n",
        "    array_join(s.user_api_scopes, ', ') AS user_api_scopes,\n",
        "    o.last_obo_date,\n",
        "    coalesce(o.obo_users_window, 0) AS obo_users_window,\n",
        "    coalesce(o.obo_events_window, 0) AS obo_events_window,\n",
        "    coalesce(b.dbus_window, 0) AS dbus_window,\n",
        "    b.last_billed_date,\n",
        "    s.url,\n",
        "    s.snapshot_time,\n",
        "    CASE WHEN coalesce(o.obo_events_window, 0) = 0 THEN 1 ELSE 0 END AS flag_no_usage,\n",
        "    CASE WHEN coalesce(b.dbus_window, 0) > 0 AND coalesce(o.obo_users_window, 0) = 0 THEN 1 ELSE 0 END AS flag_billed_no_users,\n",
        "    CASE WHEN size(s.user_api_scopes) = 0 AND coalesce(o.obo_events_window, 0) = 0 THEN 1 ELSE 0 END AS flag_sp_only,\n",
        "    CASE WHEN s.compute_state IN ('STOPPED', 'ERROR') OR s.active_deployment_id IS NULL THEN 1 ELSE 0 END AS flag_stopped_or_never_deployed,\n",
        "    CASE WHEN greatest(\n",
        "        coalesce(s.active_deployment_update_time, s.active_deployment_create_time, s.create_time),\n",
        "        coalesce(s.update_time, s.create_time)\n",
        "      ) < date_sub(current_date(), :stale_days) THEN 1 ELSE 0 END AS flag_stale_deploy,\n",
        "    CASE WHEN coalesce(s.creator_active, false) = false THEN 1 ELSE 0 END AS flag_creator_inactive,\n",
        "    CASE WHEN c.creator_app_count > :creator_app_threshold THEN 1 ELSE 0 END AS flag_over_creator\n",
        "  FROM snap s\n",
        "  LEFT JOIN creator_counts c ON c.creator <=> s.creator\n",
        "  LEFT JOIN obo o ON o.app_name = s.app_name\n",
        "  LEFT JOIN billed b ON b.app_id = s.app_id\n",
        ")\n",
        "SELECT\n",
        "  *,\n",
        "  concat_ws(', ',\n",
        "    CASE WHEN flag_no_usage = 1 THEN 'no_usage' END,\n",
        "    CASE WHEN flag_billed_no_users = 1 THEN 'billed_no_users' END,\n",
        "    CASE WHEN flag_sp_only = 1 THEN 'sp_only' END,\n",
        "    CASE WHEN flag_stopped_or_never_deployed = 1 THEN 'stopped_or_never_deployed' END,\n",
        "    CASE WHEN flag_stale_deploy = 1 THEN 'stale_deploy' END,\n",
        "    CASE WHEN flag_creator_inactive = 1 THEN 'creator_inactive' END,\n",
        "    CASE WHEN flag_over_creator = 1 THEN 'over_creator' END\n",
        "  ) AS reasons,\n",
        "  CASE\n",
        "    WHEN flag_no_usage = 1\n",
        "      AND (flag_sp_only = 0 OR flag_stopped_or_never_deployed = 1 OR flag_stale_deploy = 1 OR flag_creator_inactive = 1)\n",
        "      THEN 1 ELSE 0\n",
        "  END AS is_deletion_candidate,\n",
        "  CASE\n",
        "    WHEN flag_no_usage = 1\n",
        "      AND (flag_sp_only = 0 OR flag_stopped_or_never_deployed = 1 OR flag_stale_deploy = 1 OR flag_creator_inactive = 1)\n",
        "      THEN 'Deletion candidate' ELSE 'Keep'\n",
        "  END AS candidate_label,\n",
        "  CASE WHEN flag_billed_no_users = 1 THEN dbus_window ELSE 0 END AS wasted_dbus\n",
        "FROM facts\n",
        "ORDER BY is_deletion_candidate DESC, dbus_window DESC, app_name\n"
      ],
      "parameters": [
        {
          "displayName": "usage_days",
          "keyword": "usage_days",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "30"
                }
              ]
            }
          }
        },
        {
          "displayName": "stale_days",
          "keyword": "stale_days",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "60"
                }
              ]
            }
          }
        },
        {
          "displayName": "creator_app_threshold",
          "keyword": "creator_app_threshold",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "3"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_over_creator_apps",
      "displayName": "Apps owned by creators over threshold",
      "queryLines": [
        "WITH creator_counts AS (\n",
        "  SELECT creator, count(*) AS creator_app_count\n",
        "  FROM apps_inventory_snapshot\n",
        "  GROUP BY creator\n",
        ")\n",
        "SELECT\n",
        "  s.creator,\n",
        "  s.creator_type,\n",
        "  s.creator_active,\n",
        "  c.creator_app_count,\n",
        "  s.app_name,\n",
        "  s.compute_state,\n",
        "  s.create_time,\n",
        "  s.update_time\n",
        "FROM apps_inventory_snapshot s\n",
        "INNER JOIN creator_counts c ON c.creator <=> s.creator\n",
        "WHERE c.creator_app_count > :creator_app_threshold\n",
        "ORDER BY c.creator_app_count DESC, s.creator, s.app_name\n"
      ],
      "parameters": [
        {
          "displayName": "creator_app_threshold",
          "keyword": "creator_app_threshold",
          "dataType": "INTEGER",
          "defaultSelection": {
            "values": {
              "dataType": "INTEGER",
              "values": [
                {
                  "value": "3"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_spend_trend",
      "displayName": "Apps daily DBUs",
      "queryLines": [
        "WITH daily AS (\n",
        "  SELECT\n",
        "    u.usage_date,\n",
        "    coalesce(s.app_name, u.usage_metadata.app_name, u.usage_metadata.app_id) AS app_name,\n",
        "    sum(u.usage_quantity) AS dbus\n",
        "  FROM system.billing.usage u\n",
        "  LEFT JOIN apps_inventory_snapshot s ON s.app_id = u.usage_metadata.app_id\n",
        "  WHERE u.usage_date >= date_sub(current_date(), 90)\n",
        "    AND u.usage_metadata.app_id IS NOT NULL\n",
        "    AND u.workspace_id IN (SELECT DISTINCT workspace_id FROM apps_inventory_snapshot)\n",
        "  GROUP BY\n",
        "    u.usage_date,\n",
        "    coalesce(s.app_name, u.usage_metadata.app_name, u.usage_metadata.app_id)\n",
        "),\n",
        "ranked AS (\n",
        "  SELECT app_name, row_number() OVER (ORDER BY sum(dbus) DESC, app_name) AS spend_rank\n",
        "  FROM daily\n",
        "  GROUP BY app_name\n",
        ")\n",
        "SELECT\n",
        "  d.usage_date,\n",
        "  CASE WHEN r.spend_rank <= 7 THEN d.app_name ELSE 'Other' END AS app_series,\n",
        "  sum(d.dbus) AS dbus\n",
        "FROM daily d\n",
        "INNER JOIN ranked r ON r.app_name = d.app_name\n",
        "GROUP BY d.usage_date, CASE WHEN r.spend_rank <= 7 THEN d.app_name ELSE 'Other' END\n",
        "ORDER BY d.usage_date\n"
      ]
    },
    {
      "name": "ds_usage_trend",
      "displayName": "Apps daily OBO usage",
      "queryLines": [
        "SELECT\n",
        "  o.activity_date,\n",
        "  count(DISTINCT o.user_email) AS obo_users,\n",
        "  sum(o.event_count) AS obo_events,\n",
        "  count(DISTINCT s.app_name) AS apps_with_obo\n",
        "FROM app_obo_activity_daily o\n",
        "INNER JOIN apps_inventory_snapshot s\n",
        "  ON o.workspace_id = s.workspace_id\n",
        "  AND regexp_extract(o.acting_resource, '([^/]+)$', 1) IN (s.oauth2_app_client_id, s.app_id, s.app_name)\n",
        "GROUP BY o.activity_date\n",
        "ORDER BY o.activity_date\n"
      ]
    }
  ],
