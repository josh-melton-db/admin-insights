    {
      "name": "deletion_candidates",
      "displayName": "Deletion candidates",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "dc_title",
            "multilineTextboxSpec": {
              "lines": [
                "## Deletion candidates\n",
                "\n",
                "One row per app. A deletion candidate has no user OBO activity in the usage window AND either declares user_api_scopes (built for users) or shows abandonment (stopped / never deployed, stale deploy, inactive creator). Nothing is deleted automatically.\n"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "dc_filter_candidate",
            "queries": [
              {
                "name": "q_candidate",
                "query": {
                  "datasetName": "ds_apps",
                  "fields": [
                    {
                      "name": "candidate_label",
                      "expression": "`candidate_label`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-single-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "candidate_label",
                    "displayName": "Candidate",
                    "queryName": "q_candidate"
                  }
                ]
              },
              "selection": {
                "defaultSelection": {
                  "values": {
                    "dataType": "STRING",
                    "values": [
                      {
                        "value": "Deletion candidate"
                      }
                    ]
                  }
